{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TeamHub Web Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["tsx"],
            "program": "${workspaceFolder}/server/index.ts",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "${workspaceFolder}/node_modules/**"
            ],
            "env": {
                "NODE_ENV": "development",
                "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/teamhub",
                "SESSION_SECRET": "password",
                "PORT": "5000"
            },
            "sourceMaps": true,
            "restart": true
        },
        {
            "name": "TeamHub (with .env.local)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["tsx"],
            "program": "${workspaceFolder}/server/index.ts",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "${workspaceFolder}/node_modules/**"
            ],
            "envFile": "${workspaceFolder}/.env.local",
            "sourceMaps": true,
            "restart": true
        }
    ]
}